# ─────────────────────────────────────────────

# .env — Variables de entorno del scraper

# ¡NO subas este archivo a Git!

# Añade .env a tu .gitignore

# ─────────────────────────────────────────────

# ── Notificaciones Telegram ──────────────────

# 1. Crea un bot con @BotFather en Telegram

# 2. Copia el token aquí

# 3. Obtén tu chat_id enviando un mensaje al bot

# y consultando: https://api.telegram.org/bot<TOKEN>/getUpdates

TELEGRAM_BOT_TOKEN=tu_token_aqui
TELEGRAM_CHAT_ID=tu_chat_id_aqui

# ── Notificaciones Email (Gmail) ─────────────

# Requiere contraseña de aplicación (no la normal):

# Google → Seguridad → Contraseñas de aplicación

EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_USER=tu_email@gmail.com
EMAIL_PASSWORD=tu_contraseña_de_app
EMAIL_RECIPIENT=destino@email.com

# ── Canal de notificaciones ──────────────────

# Opciones: telegram | email | both | none

NOTIFICATION_CHANNEL=telegram

# ── Proxy (opcional) ─────────────────────────

# PROXY_HTTP=http://user:pass@host:port

# PROXY_HTTPS=https://user:pass@host:port
